{
  "expo": {
    "name": "MicroMart",
    "slug": "MicroMart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/micromart-icon.png",
    "scheme": "micromart",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/micromart-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFBF7",
        "foregroundImage": "./assets/images/micromart-android-foreground.png",
        "monochromeImage": "./assets/images/micromart-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shiraishi_rn.MicroMart"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/micromart-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFBF7",
          "image": "./assets/images/micromart-android-foreground.png",
          "imageWidth": 180
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "187dae88-0a85-42dd-9cf9-8b12c154fc26"
      }
    }
  }
}
